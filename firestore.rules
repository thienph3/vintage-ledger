rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: chỉ owner đọc/ghi
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Accounts + subcollections: chỉ members đọc/ghi
    match /accounts/{accountId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.member_ids;

      // Cho phép tạo account mới (chưa có resource.data)
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.member_ids;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.member_ids;
      }
    }
  }
}
