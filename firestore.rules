rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    // #1: Check if authenticated user is a member of the account
    function isMember(accountId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.member_ids;
    }

    function isOwner(accountId) {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/accounts/$(accountId)).data.owner_id;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── #6: User profiles ──

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isCurrentUser(userId);

      match /settings/{docId} {
        allow read, write: if isCurrentUser(userId);
      }

      match /fcm_tokens/{tokenId} {
        allow read: if isAuthenticated();
        allow write: if isCurrentUser(userId);
      }
    }

    // ── #2: Accounts ──

    match /accounts/{accountId} {
      // Any member can read
      allow read: if isMember(accountId);

      // Create: user must be in member_ids of new doc
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.member_ids &&
        request.resource.data.owner_id == request.auth.uid;

      // Update: owner can update anything; authenticated user can only add themselves to member_ids (join)
      allow update: if isOwner(accountId) ||
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_ids']) &&
         request.auth.uid in request.resource.data.member_ids);

      // Delete: only owner
      allow delete: if isOwner(accountId);

      // ── #3: Data subcollections (wallets, transactions, categories, budgets) ──

      match /wallets/{walletId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);

        match /goals/{goalId} {
          allow read: if isMember(accountId);
          allow create: if isMember(accountId) &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.target_amount is int &&
            request.resource.data.target_amount > 0;
          allow update: if isMember(accountId);
          allow delete: if isMember(accountId);
        }
      }

      match /transactions/{docId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0 &&
          request.resource.data.type in ['income', 'expense', 'transfer_out', 'transfer_in'];
        allow update: if isMember(accountId) &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0 &&
          request.resource.data.type in ['income', 'expense', 'transfer_out', 'transfer_in'];
        allow delete: if isMember(accountId);

        match /reactions/{userId} {
          allow read: if isMember(accountId);
          allow create, update: if isMember(accountId) && isCurrentUser(userId);
          allow delete: if isCurrentUser(userId);
        }
      }

      match /categories/{docId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);
      }

      match /budgets/{docId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.amount_limit is int &&
          request.resource.data.amount_limit > 0;
        allow update: if isMember(accountId) &&
          request.resource.data.amount_limit is int &&
          request.resource.data.amount_limit > 0;
        allow delete: if isMember(accountId);
      }

      match /debts/{debtId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.type in ['lend', 'borrow'] &&
          request.resource.data.total_amount is int &&
          request.resource.data.total_amount > 0 &&
          request.resource.data.party_name is string &&
          request.resource.data.party_name.size() > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);

        match /payments/{paymentId} {
          allow read: if isMember(accountId);
          allow create: if isMember(accountId) &&
            request.resource.data.amount is int &&
            request.resource.data.amount > 0;
          allow update: if isMember(accountId);
          allow delete: if isMember(accountId);
        }
      }

      // V2 collections for R10
      match /debts_v2/{debtId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.type in ['lend', 'borrow'] &&
          request.resource.data.total_amount is int &&
          request.resource.data.total_amount > 0 &&
          request.resource.data.party_name is string &&
          request.resource.data.party_name.size() > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);

        match /payments/{paymentId} {
          allow read: if isMember(accountId);
          allow create: if isMember(accountId) &&
            request.resource.data.amount is int &&
            request.resource.data.amount > 0;
          allow update: if isMember(accountId);
          allow delete: if isMember(accountId);
        }
      }

      match /goals_v2/{goalId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.target_amount is int &&
          request.resource.data.target_amount > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);

        match /contributions/{contributionId} {
          allow read: if isMember(accountId);
          allow create: if isMember(accountId) &&
            request.resource.data.amount is int &&
            request.resource.data.amount != 0;
          allow update: if isMember(accountId);
          allow delete: if isMember(accountId);
        }
      }

      match /auto_saving_rules/{ruleId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);
      }

      match /transfers_v2/{transferId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0 &&
          request.resource.data.type in ['internal', 'funding', 'cross_account'];
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);
      }

      match /transfer_shortcuts/{shortcutId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.label is string &&
          request.resource.data.label.size() > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);
      }

      match /recurring_rules/{docId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId) &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0;
        allow update: if isMember(accountId);
        allow delete: if isMember(accountId);
      }

      // ── #4: Activities ──

      match /activities/{docId} {
        allow read: if isMember(accountId);
        // Create: must be member + user_id must match auth uid
        allow create: if isMember(accountId) &&
          request.resource.data.user_id == request.auth.uid;
        // No update or delete
        allow update, delete: if false;
      }

      match /notification_events/{eventId} {
        allow read: if isMember(accountId);
        allow create: if isMember(accountId);
        allow delete: if isMember(accountId);
        allow update: if false;
      }
    }

    // ── #5: Pending invites ──

    match /pending_invites/{inviteId} {
      // Target user or sender can read
      allow read: if isAuthenticated() &&
        (resource.data.to_user_id == request.auth.uid ||
         resource.data.from_user_id == request.auth.uid);

      // Any authenticated user can create (sender)
      allow create: if isAuthenticated() &&
        request.resource.data.from_user_id == request.auth.uid;

      // Target user can update status (accept/reject)
      allow update: if isAuthenticated() &&
        resource.data.to_user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // ── User email lookup ──

    match /user_emails/{email} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    // ── Config (FCM server key) ──

    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
